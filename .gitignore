# Deny-by-default. `*` ignores everything; each rule below names back exactly
# what claudit ships. An unlisted file is invisible to git and can never be
# committed by accident — which is the point, because this working tree also
# holds .env, .secrecy-literals, a .venv, scratch analysis and generated
# artefacts that must never reach the remote.
#
# The mechanic, because the pattern fails silently without it: git does not
# look inside a directory it has already ignored. So every kept directory is
# re-opened (`!dir/`), its contents denied again (`dir/*`), and its files are
# named back by a glob SCOPED to that directory. That scoping is the point —
# it is what stops a `!*.py` from reaching into `__pycache__/` or `.venv/`.
#
# Adding a file whose type is not already named back for its directory means
# adding a rule here. `git status` will NOT tell you the file is missing; it
# simply never appears. `git check-ignore -v <path>` names the rule hiding it.

*

# ---- repository root ------------------------------------------------------
# eslint.config.mjs is the JS lint gate's config (flat config since issue
# #361); package.json + package-lock.json are the CI toolchain manifest
# Dependabot bumps — devDependencies only, no frontend build step.
!/eslint.config.mjs
!/.dockerignore
!.gitattributes
!/.gitignore
!/.gitleaks.toml
!/.pylintrc
!/AGENTS.md
!/CLAUDE.md
!/CONTRIBUTING.md
!/Dockerfile
!/LICENSE
!/NOTICE
# The root-level PARSER_VERSION bump history (issue #986), pointed at
# by .claude/rules/claudit-doctrine.md's SV-PARSER-VERSION section.
!/PARSER_VERSION_HISTORY.md
!/PRESENTATION.txt
!/PRIVACY.md
!/README.md
!/SECURITY.md
!/VERSION
!/compose.yaml
!/package-lock.json
!/package.json
!/pyrightconfig.json
!/requirements-dev.txt
!/requirements-pip-audit.txt
!/requirements-test.txt
!/requirements-zizmor.txt
!/setup.cfg

# ---- .claude/ — local doctrine (SV-* rules) -------------------------------
!/.claude/
/.claude/*
!/.claude/rules/
/.claude/rules/*
!/.claude/rules/claudit-doctrine*.md

# ---- .github/ — CI workflows, dependabot, issue and PR forms ---------------
!/.github/
/.github/*
!/.github/dependabot.yml
!/.github/ci-thresholds.json
# docker-smoke's CI-only Compose override (cached Postgres image).
!/.github/docker-smoke.compose.yaml
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/*.md
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml
# Composite actions the workflows call. The directory is re-opened first:
# git never looks inside a directory it has already ignored, so a name-back
# below this line would not match without it.
!/.github/actions/
/.github/actions/*
!/.github/actions/*/
!/.github/actions/*/action.yml

# ---- backend/ — FastAPI app ------------------------------------------------
# `!/backend/*.py` is deliberately unanchored-free (no `**`): it matches only
# files directly in backend/, so backend/__pycache__/ stays denied by
# `/backend/*` and git never descends into it.
!/backend/
/backend/*
!/backend/*.py
!/backend/file_timelines.py
!/backend/api_latency_rollup.py
!/backend/.env.example
!/backend/requirements.txt
!/backend/schema.sql
# The schema is an ordered list of files now (db.SCHEMA_PATHS, issue #436);
# every one of them is shipped, so the block names the family back rather
# than one file.
!/backend/schema_*.sql
!/backend/schema_timelines.sql

# ---- compose/ — the dev stack's Postgres first-boot init -------------------
# The docker compose stack's init SQL (issue #941): deliberately NOT under
# examples/, which the CI classifier marks documentation, so a change to it
# still runs the smoke leg. Only .sql is shipped here.
!/compose/
/compose/*
!/compose/*.sql

# ---- examples/ — sample systemd unit ---------------------------------------
!/examples/
/examples/*
!/examples/*.service

# ---- fixtures/ — small parser + end-to-end samples -------------------------
!/fixtures/
/fixtures/*
!/fixtures/*.md
!/fixtures/parser/
/fixtures/parser/*
!/fixtures/parser/*.jsonl
# codex/ holds codexmeter's synthetic rollout fixtures: multi-event files
# whose expected token relationships are documented in its README.md.
!/fixtures/codex/
/fixtures/codex/*
!/fixtures/codex/*.jsonl
!/fixtures/codex/*.md
!/fixtures/vendor_catalog/
/fixtures/vendor_catalog/*
!/fixtures/vendor_catalog/*.json
!/fixtures/vendor_catalog/*.md
# r2_mini is a MIRROR of an R2 bucket — its shape is
# claude/<project>/<session>/... and a new fixture session adds directories at
# arbitrary depth, so descendants are re-opened recursively instead of being
# enumerated. The name-back list stays SCOPED to this subtree, so only the file
# types the mirror actually ships can get through — a lane subagent's sidecar
# is meta.json (key_layout._LANE_AGENT_META), where a Claude one is
# agent-<id>.meta.json.
!/fixtures/r2_mini/
/fixtures/r2_mini/**
!/fixtures/r2_mini/**/
!/fixtures/r2_mini/**/*.jsonl
!/fixtures/r2_mini/**/*.txt
!/fixtures/r2_mini/**/*.meta.json
!/fixtures/r2_mini/**/meta.json
# layout/ is the frozen payload set the rendered-layout guard
# (scripts/ci/panel_layout.mjs, issue #631) drives the dashboard with —
# one JSON per /api path the frontend fetches, captured from a generated
# mirror so the guard never reads a live meter or the box's database. The
# directory is re-opened explicitly: git does not look inside a directory
# it has already ignored, so the name-back below would never match.
!/fixtures/layout/
/fixtures/layout/*
!/fixtures/layout/*.json

# ---- public/ — static assets served at / -----------------------------------
!/public/
/public/*
!/public/*.css
!/public/*.html
!/public/favicon.ico
!/public/vendor/
/public/vendor/*
!/public/vendor/*.js
!/public/vendor/LICENSES.txt

# ---- scripts/ — repo tooling ----------------------------------------------
!/scripts/
/scripts/*
!/scripts/*.sh
!/scripts/bench_parser.py
!/scripts/uuid_gate.py
!/scripts/pre-push
!/scripts/ci/
/scripts/ci/*
!/scripts/ci/*.py
!/scripts/ci/*.txt
!/scripts/ci/*.json
# panel_layout.mjs drives the rendered-layout guard (issue #631) in its
# own CI job; it is node, not python, and nothing else under scripts/ci
# is.
!/scripts/ci/*.mjs
!/scripts/plots/
/scripts/plots/*
!/scripts/plots/*.py

# ---- src/ — React JSX modules served at /src/* -----------------------------
!/src/
/src/*
!/src/*.js
!/src/*.jsx
!/src/pricing.json
!/src/pricing_notices.json
!/src/views/
/src/views/*
!/src/views/*.jsx

# ---- tests/ — pytest suite -------------------------------------------------
!/tests/
/tests/*
!/tests/*.py
# The API-response parity capture (issue #959): golden payloads the
# pre-migration code produced, compared after the surrogate-id change.
!/tests/dims_api_golden.json
