[MASTER]

[MESSAGES CONTROL]
disable=
    line-too-long,
    missing-function-docstring,
    missing-module-docstring,
    missing-class-docstring,
    unused-argument,
    arguments-differ,
    import-error,
    invalid-name,
    no-name-in-module,
    broad-exception-caught,
    broad-exception-raised,
    global-statement,
    too-few-public-methods,
# The flat 1000-line module limit is replaced by the per-file size
# gate: the Nitjsefnie-Actions/size-ratchet action caps every file
# (production 500 / test 700; .github/size-baseline.json records) and
# never raises or adds an entry by hand — grow by moving code into a
# new module. For every file under its ceiling this is stricter than
# the flat 1000.
    too-many-lines
max-attributes=30
max-args=10
max-positional-arguments=10
min-similarity-lines=15
