# App configuration uses CLAUDIT_ names. Unprefixed names shipped in v0.4.0
# still work as deprecated fallbacks for one release; prefixed values win,
# including empty values. Startup names active fallbacks once (no values).
# GUEST_LOGIN and the blob-cache names were unreleased: no fallback.

# Postgres
CLAUDIT_DATABASE_URL_VIZ=postgresql:///claudit
# External users DB (PBKDF2 web_password_hash lookups, read-only)
CLAUDIT_DATABASE_URL_AUTH=postgresql:///users

# R2 (S3 API). For a local mirror, set CLAUDIT_R2_ENDPOINT=file:///path/to/r2/
# and leave the access keys empty.
CLAUDIT_R2_ENDPOINT=file:///tmp/r2/
CLAUDIT_R2_ACCESS_KEY_ID=
CLAUDIT_R2_SECRET_ACCESS_KEY=
# Several buckets per deploy: join their names with '+' — e.g.
# CLAUDIT_R2_BUCKET=codex+kimi. Every stored file key is qualified with its
# bucket; one deploy can ingest several buckets at once.
CLAUDIT_R2_BUCKET=claude

# Disk blob cache (#684): a directory the ingest's fetches consult before
# each GET — a (key, etag) hit is answered from disk, so a PARSER_VERSION
# reparse reads unchanged objects locally instead of re-downloading the
# bucket. Entries hold raw (compressed) bytes; the cache is size-capped
# LRU (CLAUDIT_R2_BLOB_CACHE_MAX_BYTES, default 4 GiB) and pruned each run beside
# the orphan sweep. Unset = off. Recommended on live S3-mode deploys
# whose disk can spare the bucket's compressed size; file-mode mirrors
# are already local and leave it unset.
#CLAUDIT_R2_BLOB_CACHE=
#CLAUDIT_R2_BLOB_CACHE_MAX_BYTES=

# Export-PNG subprocess interpreter (default /usr/bin/python3). The plot
# script imports matplotlib AND psycopg; matplotlib ships only in
# requirements-dev.txt (NOT backend/requirements.txt), so a quickstart
# venv cannot render exports. Point this at a Python that has
# backend/requirements.txt + requirements-dev.txt installed.
#CLAUDIT_EXPORT_PYTHON=/path/to/venv/bin/python

# Startup collection switches (unset = ON; set to 0 to disable). Collection
# choices are read at startup and take effect on the next successful ingest.
#CLAUDIT_COLLECT_TURN_CONTEXT=1
#CLAUDIT_COLLECT_REQUEST_METADATA=1
#CLAUDIT_COLLECT_CACHE_WRITE_TOKENS=1
#CLAUDIT_COLLECT_CONTEXT_INTAKE=1
#CLAUDIT_COLLECT_ERROR_TEXT=1
#CLAUDIT_COLLECT_FILE_EXTRAS=1
#CLAUDIT_COLLECT_TOOL_ERROR_KINDS=1
#CLAUDIT_COLLECT_DISPATCH_ANALYTICS=1
# Claude generation duration and output speed; other lanes store NULL.
#CLAUDIT_COLLECT_GENERATION_SPEED=1

# Feature switches (unset = ON; set to 0 to disable). They are read at
# startup and control display/API availability after restart.
#CLAUDIT_FEATURE_USAGE_TIMESERIES=1
#CLAUDIT_FEATURE_THINKING_OUTPUT=1
#CLAUDIT_FEATURE_LINE_CHURN=1
#CLAUDIT_FEATURE_MODEL_COMPARISON=1
#CLAUDIT_FEATURE_TOKEN_BREAKDOWN=1
#CLAUDIT_FEATURE_PROJECT_COMPARISON=1
#CLAUDIT_FEATURE_CACHE_TTL=1
#CLAUDIT_FEATURE_RESPONSE_SIZES=1
#CLAUDIT_FEATURE_CONTEXT_GROWTH=1
#CLAUDIT_FEATURE_BURN_RATE=1
#CLAUDIT_FEATURE_CONTEXT_COMPARISON=1
#CLAUDIT_FEATURE_TOOL_USAGE=1
#CLAUDIT_FEATURE_REPLY_LATENCY=1
#CLAUDIT_FEATURE_PAGE_PERFORMANCE=1
#CLAUDIT_FEATURE_TOOL_ERROR_RATE=1
#CLAUDIT_FEATURE_AGENT_COMPARISON=1
#CLAUDIT_FEATURE_ACTIVITY_HEATMAP=1
#CLAUDIT_FEATURE_SUMMARY=1
#CLAUDIT_FEATURE_RATE_LIMITS=1
#CLAUDIT_FEATURE_SESSIONS=1
#CLAUDIT_FEATURE_CACHE=1
#CLAUDIT_FEATURE_INSPECTOR=1
#CLAUDIT_FEATURE_PROJECT_PICKER=1
#CLAUDIT_FEATURE_EXPORT_PNG=1
#CLAUDIT_FEATURE_LIVE_UPDATES=1
# Legacy inverse alias: unset = OFF. A truthy value hides rate-limit
# display even when CLAUDIT_FEATURE_RATE_LIMITS=1; events stay collected.
#CLAUDIT_HIDE_RATE_LIMITS=0
# Explicit values are lowercased without trimming: "", "0", "false",
# and "no" are false; every other value (including "off" and whitespace)
# is true. Use 0 to disable portably.

# Operations / debug toggles:
# - CLAUDIT_INGEST_WORKERS — in-process pipeline: ingest fetch+parse thread
#   concurrency (also the markers pool when CLAUDIT_INGEST_PARSE_PROCESSES>1).
#   Unset/unparseable = auto = min(16, 2 x CPU cores); an explicit
#   integer is honoured, clamped to >= 1, so CLAUDIT_INGEST_WORKERS=1 is a real
#   sequential switch for debugging.
# - CLAUDIT_INGEST_PARSE_PROCESSES — parse-process concurrency of the process
#   pool (issue #309). The parse is pure-Python CPU work, so threads are
#   GIL-serialised; forked children scale with cores. Unset/unparseable
#   = auto = min(8, CPU cores // 2); 1 = the in-process pipeline (the
#   test suite pins 1).
# - CLAUDIT_INGEST_PERSIST_THREADS — persist-thread concurrency of the process
#   pool; each thread commits one file per transaction from the shared
#   viz pool. Unset/unparseable = 4; 1 = serial persist.
# - CLAUDIT_WARM_CACHE — set to 0/false/no to disable the post-ingest
#   warm of the common dashboard views (the test suites set 0).
# - CLAUDIT_TIMING — set to any value other than 0/false/no/empty to
#   log per-request phase timings for the heavy read endpoints and one
#   per-run phase-timing line for each ingest.

# Auth + admin
CLAUDIT_ADMIN_TOKEN=change-me-32-byte-random
CLAUDIT_COOKIE_SECURE=1
# Guest login defaults on (unset, empty, or whitespace-only also enable it).
# 1/true/yes/on enable; 0/false/no/off or any unrecognised value disable.
# Disabled: no guest button, /login/guest returns 404, guest cookies refused.
CLAUDIT_GUEST_LOGIN=1

# Branding (optional). What the UI calls the app: the browser title and
# meta description, the logo, the sign-in page, the export-PNG filename.
# A codexmeter deploy sets CLAUDIT_APP_NAME=codexmeter etc.; unset, every
# default reproduces the claudit strings exactly.
#CLAUDIT_APP_NAME=claudit
#CLAUDIT_APP_TITLE=claudit · Claude Code Usage Dashboard
#CLAUDIT_APP_DESCRIPTION=Self-hosted dashboards for Claude Code session JSONL: cost-by-model, token breakdown, prompt-cache TTL split, response sizes, per-session context growth, session burn rate, tool-usage ratio, reply latency.
# Optional URL of a privacy notice shown on the sign-in page; unset = no
# notice. Only http://, https:// or a site-relative path (/privacy) is
# accepted; anything else drops the link and logs a warning.
#CLAUDIT_APP_PRIVACY_NOTICE_URL=
