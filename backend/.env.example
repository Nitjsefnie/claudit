# Postgres
DATABASE_URL_VIZ=postgresql:///claudit
# External users DB. Requires WRITE access: login/revoke INSERT and UPDATE
# web_sessions, alongside the reads of users.config (PBKDF2 password checks).
DATABASE_URL_AUTH=postgresql:///users

# R2 (S3 API). For a local mirror, set R2_ENDPOINT=file:///path/to/r2/
# and leave the access keys empty.
R2_ENDPOINT=file:///tmp/r2/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=claude

# Auth + admin
ADMIN_TOKEN=change-me-32-byte-random
COOKIE_SECURE=1

# Signing secret for guest sessions. Unset = a new random secret each start,
# which signs out every guest on restart.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GUEST_SESSION_SECRET=

# Versioning — bump to invalidate every parsed session row
PARSER_VERSION=1
