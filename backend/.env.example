# Postgres
DATABASE_URL_VIZ=postgresql:///claudit
# External users DB (PBKDF2 web_password_hash lookups, read-only)
DATABASE_URL_AUTH=postgresql:///users

# R2 (S3 API). For a local mirror, set R2_ENDPOINT=file:///path/to/r2/
# and leave the access keys empty.
R2_ENDPOINT=file:///tmp/r2/
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Several buckets per deploy: join their names with '+' — e.g.
# R2_BUCKET=codex+kimi. Every stored file key is qualified with its
# bucket; one deploy can ingest several buckets at once.
R2_BUCKET=claude

# Export-PNG subprocess interpreter (default /usr/bin/python3). The plot
# script imports matplotlib AND psycopg; matplotlib ships only in
# requirements-dev.txt (NOT backend/requirements.txt), so a quickstart
# venv cannot render exports. Point this at a Python that has
# backend/requirements.txt + requirements-dev.txt installed.
#EXPORT_PYTHON=/path/to/venv/bin/python

# Operations / debug toggles:
# - INGEST_WORKERS — in-process pipeline: ingest fetch+parse thread
#   concurrency (also the markers pool when INGEST_PARSE_PROCESSES>1).
#   Unset/unparseable = auto = min(16, 2 x CPU cores); an explicit
#   integer is honoured, clamped to >= 1, so INGEST_WORKERS=1 is a real
#   sequential switch for debugging.
# - INGEST_PARSE_PROCESSES — parse-process concurrency of the process
#   pool (issue #309). The parse is pure-Python CPU work, so threads are
#   GIL-serialised; forked children scale with cores. Unset/unparseable
#   = auto = min(8, CPU cores // 2); 1 = the in-process pipeline (the
#   test suite pins 1).
# - INGEST_PERSIST_THREADS — persist-thread concurrency of the process
#   pool; each thread commits one file per transaction from the shared
#   viz pool. Unset/unparseable = 4; 1 = serial persist.
# - CLAUDIT_WARM_CACHE — set to 0/false/no to disable the post-ingest
#   warm of the common dashboard views (the test suites set 0).
# - CLAUDIT_TIMING — set to any value other than 0/false/no/empty to
#   log per-request phase timings for the heavy read endpoints and one
#   per-run phase-timing line for each ingest.

# Auth + admin
ADMIN_TOKEN=change-me-32-byte-random
COOKIE_SECURE=1

# Branding (optional). What the UI calls the app: the browser title and
# meta description, the logo, the sign-in page, the export-PNG filename.
# A codexmeter deploy sets APP_NAME=codexmeter etc.; unset, every
# default reproduces the claudit strings exactly.
#APP_NAME=claudit
#APP_TITLE=claudit · Claude Code Usage Dashboard
#APP_DESCRIPTION=Self-hosted dashboards for Claude Code session JSONL: cost-by-model, token breakdown, prompt-cache TTL split, response sizes, per-session context growth, session burn rate, tool-usage ratio, reply latency.
# Optional URL of a privacy notice shown on the sign-in page; unset = no
# notice. Only http://, https:// or a site-relative path (/privacy) is
# accepted; anything else drops the link and logs a warning.
#APP_PRIVACY_NOTICE_URL=
